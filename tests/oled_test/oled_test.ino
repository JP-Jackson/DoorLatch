// OLED test: SSD1306 128x64 at 0x3C, SCL D1 (GPIO5), SDA D2 (GPIO4).
// Two-color panel: rows 0-15 yellow, 16-63 blue.
// Yellow band scrolls "Cage Locked"/"Cage Unlocked" (state from D6),
// blue area shows the JP logo.
// Libraries: Adafruit SSD1306, Adafruit GFX Library.
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

const uint8_t LOCK_PIN = D6;         // lock status switch to GND, INPUT_PULLUP
const uint8_t LOCKED_LEVEL = LOW;    // flip if the switch reads backwards
const uint16_t SCROLL_MS = 30;       // ms per 2 px step

// JP logo, traced from the source image (1 bit, MSB first).
const uint8_t JP_W = 44, JP_H = 42;
const uint8_t JP_BMP[] PROGMEM = {
  0x7F, 0xFF, 0xFF, 0xFF, 0xFC, 0x00,
  0x7F, 0xFF, 0xFF, 0xFF, 0xFF, 0x00,
  0x7F, 0xFF, 0xFF, 0xFF, 0xFF, 0x80,
  0x7F, 0xFF, 0xFF, 0xFF, 0xFF, 0xC0,
  0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xE0,
  0x00, 0x00, 0x0F, 0xC0, 0x3F, 0xF0,
  0x00, 0x00, 0x0F, 0xC0, 0x0F, 0xF0,
  0x00, 0x00, 0x0F, 0xC0, 0x07, 0xF0,
  0x00, 0x00, 0x0F, 0xC0, 0x03, 0xF0,
  0x00, 0x00, 0x0F, 0xC0, 0x01, 0xF0,
  0x00, 0x00, 0x0F, 0xC0, 0x01, 0xF0,
  0x00, 0x00, 0x0F, 0xC0, 0x01, 0xF0,
  0x00, 0x00, 0x0F, 0xC0, 0x01, 0xF0,
  0x00, 0x00, 0x0F, 0xC0, 0x01, 0xF0,
  0x00, 0x00, 0x0F, 0xC0, 0x00, 0xF0,
  0x00, 0x00, 0x0F, 0xC0, 0x00, 0xF0,
  0x00, 0x00, 0x0F, 0xC0, 0x01, 0xE0,
  0x00, 0x00, 0x0F, 0xE0, 0x03, 0xE0,
  0x00, 0x00, 0x0F, 0xE0, 0x0F, 0xC0,
  0x00, 0x00, 0x0F, 0xFF, 0xFF, 0xC0,
  0x00, 0x00, 0x0F, 0xFF, 0xFF, 0x80,
  0x00, 0x00, 0x0F, 0xFF, 0xFE, 0x00,
  0x00, 0x00, 0x0F, 0xFF, 0xF8, 0x00,
  0x00, 0x00, 0x0F, 0xE0, 0x00, 0x00,
  0x00, 0x00, 0x0F, 0xC0, 0x00, 0x00,
  0x00, 0x00, 0x0F, 0xC0, 0x00, 0x00,
  0x00, 0x00, 0x0F, 0xC0, 0x00, 0x00,
  0x03, 0x00, 0x0F, 0xC0, 0x00, 0x00,
  0x27, 0x00, 0x0F, 0xC0, 0x00, 0x00,
  0x3F, 0x00, 0x0F, 0xC0, 0x00, 0x00,
  0x3F, 0x00, 0x0F, 0xC0, 0x00, 0x00,
  0x3F, 0x00, 0x0F, 0xC0, 0x00, 0x00,
  0x3F, 0x00, 0x0F, 0xC0, 0x00, 0x00,
  0x3F, 0x80, 0x07, 0xC0, 0x00, 0x00,
  0x3F, 0x80, 0x07, 0xC0, 0x00, 0x00,
  0x1F, 0x80, 0x0F, 0x80, 0x00, 0x00,
  0x1F, 0xE0, 0x1F, 0x80, 0x00, 0x00,
  0x1F, 0xF0, 0x3F, 0x00, 0x00, 0x00,
  0x0F, 0xFF, 0xFF, 0x00, 0x00, 0x00,
  0x07, 0xFF, 0xFE, 0x00, 0x00, 0x00,
  0x03, 0xFF, 0xF8, 0x00, 0x00, 0x00,
  0x00, 0xFF, 0xE0, 0x00, 0x00, 0x00,
};

Adafruit_SSD1306 display(128, 64, &Wire, -1);
int shownState = -1;
const char *title = "";
int16_t scrollX = 128;
uint32_t lastStep = 0;

void drawTitle() {
  display.fillRect(0, 0, 128, 16, SSD1306_BLACK);
  display.setTextSize(2);
  display.setCursor(scrollX, 0);
  display.print(title);
  display.display();
}

void setup() {
  Serial.begin(115200);
  pinMode(LOCK_PIN, INPUT_PULLUP);
  Wire.begin(D2, D1);  // SDA, SCL
  Wire.setClock(400000);
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println(F("\nSSD1306 not found at 0x3C - check wiring"));
    while (true) delay(1000);
  }
  Serial.println(F("\nOLED OK"));
  display.setTextWrap(false);
  display.setTextColor(SSD1306_WHITE);
  display.clearDisplay();
  display.drawBitmap((128 - JP_W) / 2, 19, JP_BMP, JP_W, JP_H, SSD1306_WHITE);
}

void loop() {
  int s = digitalRead(LOCK_PIN);
  if (s != shownState) {
    shownState = s;
    bool locked = (s == LOCKED_LEVEL);
    title = locked ? "Cage Locked" : "Cage Unlocked";
    scrollX = 128;
    Serial.println(title);
  }

  if (millis() - lastStep >= SCROLL_MS) {
    lastStep = millis();
    scrollX -= 2;
    if (scrollX < -(int16_t)(strlen(title) * 12)) scrollX = 128;
    drawTitle();
  }
}
